#!/bin/bash
#
# macgen
#
# Generate a random private MAC address.  (First octet must be *2, *6,
# *a, or *e.)
#
# https://www.oasys.net/fragments/identify-private-macs/
# https://www.rfc-editor.org/rfc/rfc7042.html#section-2.1
# https://serverfault.com/a/801504

mac="0x$(openssl rand -hex 6)" || exit
(( mac = mac & 0xfeffffffffff | 0x020000000000 ))

printf '%012x\n' "$mac" | sed 's/\(..\)/\1:/g; s/:$//'
