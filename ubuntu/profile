# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# kt: Custom vars

# kt: Everything is tracked with an ifndef USERENV.  Otherwise,
# appends or prepends are duplicated upon each login.  See
# https://superuser.com/q/1649684 .
if [ -z "$USERENV" ] ; then
    export EDITOR="emacsclient --alternate-editor="
    # export PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
    # export PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
    # export PERL_MB_OPT="--install_base \"$HOME/perl5\""
    # export PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"
    # if [ -n "$BASH_VERSION" ] ; then
    # 	. "${PERLBREW_ROOT:-$HOME/perl5/perlbrew}/etc/bashrc"
    # fi
    export USERENV=LOADED
fi

# kt: PATH must be treated specially b/c of too many cooks in the
# kitchen.
if ! echo "$PATH" | grep -Eqe "(^|:)$HOME/bin(:|$)" ; then
    # export PATH="$HOME/perl5/bin${PATH:+:${PATH}}"
    # export PATH="$HOME/.raku/bin:$PATH"
    export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi

# kt: Keychain - https://kernel-seeds.org/projects/keychain/

# ssh-agent spawns before X11 loads, so ssh-agent doesn't have the
# DISPLAY environment variable.  Fortunately, the Xsession scripts
# export DISPLAY to the systemd user daemon.  In order for
# per-connection key confirmation to work ('ssh-add -c' and 'keychain
# add --confirm'), ssh-agent must use this ssh-askpass wrapper that
# fetches the DISPLAY environment variable from the systemd user
# daemon.
print_askpass_wrapper() {
    cat <<'EOF'
#!/bin/sh
DISPLAY=$(systemctl --user show-environment | grep ^DISPLAY= | cut -d= -f2) \
       exec ssh-askpass "$@"
EOF
}

# Only run keychain if we are not in 'ssh -A', and if keychain exists.
if [ -z "$SSH_AUTH_SOCK" ] && which keychain > /dev/null ; then
    # Force ssh-agent to use our wrapper for ssh-askpass
    export SSH_ASKPASS="$HOME/.keychain/ssh-askpass-x11"
    export SSH_ASKPASS_REQUIRE=force
    eval "$(keychain agent start --eval --systemd)"
    # Write our wrapper if it doesn't yet exist.
    if [ ! -e "$SSH_ASKPASS" ] ; then
	print_askpass_wrapper > "$SSH_ASKPASS"
	chmod 700 "$SSH_ASKPASS"
    fi
    unset SSH_ASKPASS SSH_ASKPASS_REQUIRE
fi
unset print_askpass_wrapper

# kt: End of customizations

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
    fi
fi
